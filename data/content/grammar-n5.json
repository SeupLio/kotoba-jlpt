  },
  {
    "id": "n5-g30",
    "level": "N5",
    "pattern": "〜ね・〜よ",
    "meaning": "……吧 / ……哦（确认、告知）",
    "formation": "句尾 + ね／よ",
    "example": { "ja": "この料理はおいしいですね。", "zh": "这道菜很好吃呢。" },
    "blank": { "s": "この料理はおいしい___。", "a": "ですね" },
    "note": "「ね」寻求共鸣，「よ」向对方告知新信息。",
