    "example": { "ja": "わたしは友だちと映画を見ます。", "zh": "我和朋友一起看电影。" },
    "blank": { "s": "わたしは友だち___映画を見ます。", "a": "と" },
    "note": "也可用于引用，如「行くと言いました」。",
    "tags": ["助词"]
  },
  {
    "id": "n5-g14",
    "level": "N5",
    "pattern": "〜や〜",
    "meaning": "……和……等",
    "formation": "名词 + や + 名词",
    "example": { "ja": "机の上に本やペンがあります。", "zh": "桌上有书和笔等。" },
    "blank": { "s": "机の上に本___ペンがあります。", "a": "や" },
    "note": "只列举部分项目，暗示还有其他。",
    "tags": ["助词", "列举"]
  },
  {
    "id": "n5-g15",
    "level": "N5",
    "pattern": "〜から",
    "meaning": "从……开始",
    "formation": "时间或场所 + から",
