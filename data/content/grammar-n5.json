[
  {
    "id": "n5-g01",
    "level": "N5",
    "pattern": "〜は〜です",
    "meaning": "……是……",
    "formation": "名词 + は + 名词 + です",
    "example": { "ja": "わたしは学生です。", "zh": "我是学生。" },
    "blank": { "s": "わたしは学生___。", "a": "です" },
    "note": "否定用「ではありません」，过去用「でした」。",
    "tags": ["判断句", "基础"]
  },
  {
    "id": "n5-g02",
    "level": "N5",
    "pattern": "〜ではありません",
    "meaning": "不是……",
    "formation": "名词 + は + 名词 + ではありません",
    "example": { "ja": "わたしは先生ではありません。", "zh": "我不是老师。" },
    "blank": { "s": "わたしは先生___。", "a": "ではありません" },
    "note": "口语常说「じゃないです」。",
    "tags": ["否定", "基础"]
  },
  {
    "id": "n5-g03",
    "level": "N5",
    "pattern": "〜か",
    "meaning": "……吗？",
    "formation": "句尾 + か",
    "example": { "ja": "あなたは学生ですか。", "zh": "你是学生吗？" },
    "blank": { "s": "あなたは学生です___。", "a": "か" },
    "note": "礼貌回答用「はい」或「いいえ」。",
    "tags": ["疑问", "基础"]
  },
  {
    "id": "n5-g04",
    "level": "N5",
    "pattern": "〜も",
    "meaning": "……也……",
    "formation": "名词 + も",
    "example": { "ja": "田中さんは学生です。李さんも学生です。", "zh": "田中先生是学生，李先生也是学生。" },
    "blank": { "s": "田中さんは学生です。李さん___学生です。", "a": "も" },
    "note": "否定句中也可用「も」表示“也不”。",
    "tags": ["助词"]
  },
  {
    "id": "n5-g05",
    "level": "N5",
    "pattern": "〜の",
    "meaning": "……的（所属或修饰）",
    "formation": "名词 + の + 名词",
    "example": { "ja": "これはわたしの本です。", "zh": "这是我的书。" },
    "blank": { "s": "これはわたし___本です。", "a": "の" },
    "note": "也可表示同位语，如「友だちの田中さん」。",
    "tags": ["助词"]
  },
  {
    "id": "n5-g06",
    "level": "N5",
    "pattern": "これ・それ・あれ",
    "meaning": "这个 / 那个 / 那个（更远）",
    "formation": "これ／それ／あれ + は",
    "example": { "ja": "これは本です。", "zh": "这是书。" },
    "blank": { "s": "___は本です。", "a": "これ" },
    "note": "离说话人近用「これ」，离听话人近用「それ」，都远用「あれ」。",
    "tags": ["指示词"]
  },
  {
    "id": "n5-g07",
    "level": "N5",
    "pattern": "ここ・そこ・あそこ",
    "meaning": "这里 / 那里 / 那里（更远）",
    "formation": "ここ／そこ／あそこ + は",
    "example": { "ja": "ここは教室です。", "zh": "这里是教室。" },
    "blank": { "s": "___は教室です。", "a": "ここ" },
    "note": "礼貌说法为「こちら／そちら／あちら」。",
    "tags": ["指示词"]
  },
  {
    "id": "n5-g08",
    "level": "N5",
    "pattern": "います・あります",
    "meaning": "有 / 在（人或动物；无生命物）",
    "formation": "场所 + に + 人或动物 + が + います（无生命物用 あります）",
    "example": { "ja": "教室に学生がいます。", "zh": "教室里有学生。" },
    "blank": { "s": "教室に学生が___。", "a": "います" },
    "note": "无生命物用「あります」，如「机の上に本があります」。",
    "tags": ["存在句"]
  },
  {
    "id": "n5-g09",
    "level": "N5",
    "pattern": "〜を",
    "meaning": "表示动作的对象",
    "formation": "名词 + を + 他动词",
    "example": { "ja": "毎朝パンを食べます。", "zh": "每天早上吃面包。" },
    "blank": { "s": "毎朝パン___食べます。", "a": "を" },
    "note": "后续动词通常是他动词。",
    "tags": ["助词"]
  },
  {
    "id": "n5-g10",
    "level": "N5",
    "pattern": "〜に（时间）",
    "meaning": "在……（具体时间）",
    "formation": "具体时间 + に + 动词",
    "example": { "ja": "七時に起きます。", "zh": "七点起床。" },
    "blank": { "s": "七時___起きます。", "a": "に" },
    "note": "「今日」「毎日」等相对时间后不加「に」。",
    "tags": ["助词", "时间"]
  },
  {
    "id": "n5-g11",
    "level": "N5",
    "pattern": "〜へ",
    "meaning": "往……（方向）",
    "formation": "场所 + へ + 移动动词",
    "example": { "ja": "学校へ行きます。", "zh": "去学校。" },
    "blank": { "s": "学校___行きます。", "a": "へ" },
    "note": "表示方向时多可与「に」互换。",
    "tags": ["助词", "方向"]
  },
  {
    "id": "n5-g12",
    "level": "N5",
    "pattern": "〜で（场所）",
    "meaning": "在……（做某事）",
    "formation": "场所 + で + 动词",
    "example": { "ja": "図書館で勉強します。", "zh": "在图书馆学习。" },
    "blank": { "s": "図書館___勉強します。", "a": "で" },
    "note": "表示存在场所时用「に」，如「図書館にいます」。",
    "tags": ["助词", "场所"]
  },
  {
    "id": "n5-g13",
    "level": "N5",
    "pattern": "〜と",
    "meaning": "和……一起",
