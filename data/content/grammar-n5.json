  },
  {
    "id": "n5-g16",
    "level": "N5",
    "pattern": "〜まで",
    "meaning": "到……为止",
    "formation": "时间或场所 + まで",
    "example": { "ja": "駅まで歩きます。", "zh": "走到车站。" },
    "blank": { "s": "駅___歩きます。", "a": "まで" },
    "note": "可表示时间或空间的终点。",
    "tags": ["助词", "终点"]
  },
  {
    "id": "n5-g17",
    "level": "N5",
    "pattern": "AはBより〜",
    "meaning": "A 比 B 更……",
