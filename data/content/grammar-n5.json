    "tags": ["形容词", "时态"]
  },
  {
    "id": "n5-g22",
    "level": "N5",
    "pattern": "な形容词过去式",
    "meaning": "当时是……（な形容词或名词过去）",
    "formation": "な形容词词干或名词 + だった",
    "example": { "ja": "昔、ここは静かだった。", "zh": "以前这里很安静。" },
    "blank": { "s": "昔、ここは静か___。", "a": "だった" },
    "note": "礼貌体为「でした」。",
    "tags": ["形容词", "时态"]
  },
  {
    "id": "n5-g23",
    "level": "N5",
    "pattern": "〜てください",
    "meaning": "请……",
