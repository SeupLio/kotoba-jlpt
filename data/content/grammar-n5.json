    "tags": ["请求", "否定"]
  },
  {
    "id": "n5-g28",
    "level": "N5",
    "pattern": "〜なければなりません",
    "meaning": "必须……",
    "formation": "动词ない形去「い」 + ければなりません",
    "example": { "ja": "明日までに返さなければなりません。", "zh": "必须在明天之前归还。" },
    "blank": { "s": "明日までに返さ___。", "a": "なければなりません" },
    "note": "口语常简化为「なきゃ」。",
    "tags": ["义务"]
  },
  {
    "id": "n5-g29",
    "level": "N5",
    "pattern": "〜が（逆接）",
    "meaning": "……但是……",
    "formation": "句子 + が",
